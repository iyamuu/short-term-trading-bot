# Bitget API credentials (do NOT commit the real .env)
BOT_BITGET_API_KEY=
BOT_BITGET_API_SECRET=
BOT_BITGET_API_PASSPHRASE=

# Environment: paper | demo | live
BOT_ENV=paper

# Symbol / market
BOT_SYMBOL=BTCUSDT
BOT_PRODUCT_TYPE=USDT-FUTURES

# Storage paths
BOT_DATA_DIR=./data
BOT_STATE_DB=./data/state.db

# Discord webhook for the new bot (separate channel from the existing bot)
BOT_DISCORD_WEBHOOK=
